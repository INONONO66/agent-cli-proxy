[Unit]
Description=Agent CLI Proxy
After=network.target

[Service]
Type=simple
User=agent-proxy
WorkingDirectory=/opt/agent-cli-proxy
ExecStart=/usr/bin/env bun run dist/index.js
Restart=always
RestartSec=5
Environment="NODE_ENV=production"
Environment="AGENT_CLI_PROXY_DATA_DIR=/var/lib/agent-cli-proxy"
Environment="PRICING_CACHE_PATH=/var/cache/agent-cli-proxy/pricing-cache.json"
EnvironmentFile=/etc/agent-cli-proxy/agent-cli-proxy.env

[Install]
WantedBy=multi-user.target
